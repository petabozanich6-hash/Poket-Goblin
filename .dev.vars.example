# Copy to .dev.vars for local Worker secrets (never commit .dev.vars)
# wrangler.toml defaults to production; keep local dev in development mode.
ENVIRONMENT=development
# 32+ characters. Production refuses to authenticate without a real secret.
AUTH_SECRET=replace-with-a-long-random-string

# Optional Sprint 3 AI (omit to use labelled rule-based goblin brain)
# AI_PROVIDER=openai_compatible
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_DAILY_USER_LIMIT=40

# Optional Sprint 4 OAuth (omit → honest not_connected states)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=

# Workers AI is opt-in. Requires AI binding + migration 0009; remote inference
# can be billed even in local development. No API key needed for the binding.
# AI_PROVIDER=workers_ai
# AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8
# AI_DAILY_GLOBAL_LIMIT=100
